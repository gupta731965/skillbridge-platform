# ──────────────────────────────────────────────
# PRODUCTION Environment (Render deployment)
# ──────────────────────────────────────────────

# Server port (Render sets this automatically)
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/skillbridge
MONGO_URI=your_mongodb_atlas_uri_here

# Set to false to use real MongoDB Atlas
USE_MOCK_DB=false

# Your deployed frontend URL (e.g. https://skillbridge-demo.vercel.app)
CLIENT_URL=https://your-frontend.vercel.app

# OpenAI API key (optional — simulated AI used if blank)
OPENAI_API_KEY=your_openai_api_key_here

NODE_ENV=production
